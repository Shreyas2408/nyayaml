{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NyayaML Response Schema",
  "description": "Contract for LLM answers parsed by backend/app/llm/structured.py. Keep in sync with the LLMResponse model.",
  "type": "object",
  "required": [
    "answer",
    "citations",
    "confidence"
  ],
  "additionalProperties": true,
  "properties": {
    "answer": {
      "type": "string",
      "minLength": 1,
      "description": "The main response text"
    },
    "citations": {
      "type": "array",
      "description": "Passages the answer relies on; citation_id is verified against the corpus.",
      "items": {
        "type": "object",
        "required": [
          "citation_id"
        ],
        "additionalProperties": true,
        "properties": {
          "citation_id": {
            "type": "string",
            "minLength": 1,
            "description": "Exact corpus citation, for example BNS-2023-ff92dcc72778-S103"
          },
          "act": {
            "type": "string",
            "enum": [
              "BNS",
              "BNSS",
              "BSA"
            ]
          },
          "section": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "relevance_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Overall confidence score"
    },
    "query_type": {
      "type": "string",
      "enum": [
        "direct_lookup",
        "scenario",
        "cross_act",
        "procedural",
        "out_of_scope",
        "definition",
        "punishment"
      ]
    },
    "verification": {
      "type": "object",
      "properties": {
        "citations_verified": {
          "type": "boolean"
        },
        "hallucination_check": {
          "type": "boolean"
        },
        "cross_act_validated": {
          "type": "boolean"
        }
      }
    }
  }
}