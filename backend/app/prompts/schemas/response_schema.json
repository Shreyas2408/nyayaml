{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NyayaML Response Schema",
  "type": "object",
  "required": ["answer", "citations", "confidence"],
  "properties": {
    "answer": {
      "type": "string",
      "description": "The main response text"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["act", "section"],
        "properties": {
          "act": {
            "type": "string",
            "enum": ["BNS", "BNSS", "BSA"]
          },
          "section": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "relevance_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Overall confidence score"
    },
    "query_type": {
      "type": "string",
      "enum": ["direct_lookup", "scenario_analysis", "comparative", "procedural"]
    },
    "verification": {
      "type": "object",
      "properties": {
        "citations_verified": { "type": "boolean" },
        "hallucination_check": { "type": "boolean" },
        "cross_act_validated": { "type": "boolean" }
      }
    }
  }
}
